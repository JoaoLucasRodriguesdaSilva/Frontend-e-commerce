# Next.js public environment variables (accessible in the browser)
# Base URL of the backend API (Spring Boot)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Next.js server-side environment variables (not exposed to the browser)
# JWT secret used for signing tokens (must match the backend JWT_SECRET)
JWT_SECRET=your_32_byte_hex_secret_here

# Token lifetime in milliseconds (default: 86400000 = 24 hours, must match backend JWT_EXPIRATION_MS)
JWT_EXPIRATION_MS=86400000
